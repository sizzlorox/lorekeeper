#!/usr/bin/env bash
# lorekeeper CLI — lightweight wrapper around qmd + filesystem operations.

set -euo pipefail

CLAUDE_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
OMP_DIR="${OMP_CONFIG_DIR:-$HOME/.omp}"
# Resolve $LOREKEEPER_HOME from env, the omp marker, the Claude marker, then default.
LOREKEEPER_HOME="${LOREKEEPER_HOME:-$(cat "$OMP_DIR/.lorekeeper-home" 2>/dev/null || cat "$CLAUDE_DIR/.lorekeeper-home" 2>/dev/null || echo "$HOME/.local/share/lorekeeper")}"

# Locate hooks + the shared repo-identity resolver. Prefer a repo checkout
# (bin/../hooks), fall back to the installed canonical hooks.
_LK_SELFDIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" 2>/dev/null && pwd || echo .)"
HOOKS_DIR="$_LK_SELFDIR/../hooks"
[ -d "$HOOKS_DIR" ] || HOOKS_DIR="$LOREKEEPER_HOME/hooks"
# shellcheck source=../hooks/lib/resolve.sh disable=SC1091
[ -f "$HOOKS_DIR/lib/resolve.sh" ] && . "$HOOKS_DIR/lib/resolve.sh"

# shellcheck disable=SC2016  # $EDITOR / $LOREKEEPER_HOME are literal in help text
USAGE='lorekeeper <command> [args]

  status              install health check
  add-repo <name>     create notes/<name>/ and docs/<name>/ plus a qmd context
  note <repo> <slug>  open $EDITOR on a note (creates from template if missing)
  doc  <repo> <slug>  same, for docs
  ls [repo]           list notes/docs (optionally scoped to one repo)
  ls --orphans        list keys that look like orphaned worktree memory
  merge-key <from> <to>  move notes/docs from one key into another
  tokens [path]       estimate per-session token cost (policy + prime + precompact)
  reindex             backfill missing OKF `type:` fields, then qmd update + embed
  distill [repo]      synthesize durable docs (architecture/runbook/onboarding/
                      conventions/api) from notes + codebase. Run from the
                      repo root; arg defaults to the current git toplevel name.
                      Uses Sonnet + tools; can take minutes and cost a few $.
  skipped [repo]      review sessions the classifier discarded (→ none)
  validate <repo>     list notes not updated in 90+ days; open for review
  home                print $LOREKEEPER_HOME
  help                this message
'

die() { printf "xx %s\n" "$*" >&2; exit 1; }

cmd="${1:-help}"
shift || true

# Locate the installed template so `note` / `doc` can seed new files.
# install.sh runs from the repo root; we stash a breadcrumb there.
TEMPLATE_NOTE="$LOREKEEPER_HOME/.template-note.md"

ensure_template() {
  if [[ ! -f "$TEMPLATE_NOTE" ]]; then
    cat > "$TEMPLATE_NOTE" <<'TPL'
---
type: __TYPE__
repo: __REPO__
topic: __SLUG__
date: __DATE__
updated: __DATE__
tags: []
---

# __TITLE__

## context
<when/why this came up — 1-3 sentences>

## what i learned
<the actual content — bullets for gotchas, code refs as file:line>

## see also
<relative links or qmd:// refs>
TPL
  elif ! grep -q '^type:' "$TEMPLATE_NOTE"; then
    # Pre-OKF template already on disk. Add the type line, keep any user edits.
    local tmp; tmp="$(mktemp)"
    awk -v BINMODE=3 'NR==1 {cr = (/\r$/) ? "\r" : ""; print; print "type: __TYPE__" cr; next} {print}' \
      "$TEMPLATE_NOTE" > "$tmp"
    cat "$tmp" > "$TEMPLATE_NOTE"
    rm -f "$tmp"
  fi
}

open_editor() {
  local f="$1"
  "${EDITOR:-${VISUAL:-vi}}" "$f"
}

# --- OKF v0.1 conformance (https://github.com/GoogleCloudPlatform/knowledge-catalog) ---
# Every non-reserved .md must carry non-empty frontmatter `type`. Everything
# lorekeeper writes now does; this backfills what was written before.

okf_type_for() {
  # $1 = path relative to $LOREKEEPER_HOME. Type is a free string; derive from tree.
  case "$1" in
    docs/*/adr/*) echo "adr" ;;
    docs/*)       echo "doc" ;;
    *)            echo "note" ;;
  esac
}

# Insert `type:` into one file. Returns 0 if it changed the file, 1 if already conformant.
okf_fix_file() {
  local f="$1" type="$2" title ts tmp
  title="$(sed -n 's/^# //p' "$f" 2>/dev/null | head -1)"
  [[ -n "$title" ]] || title="$(basename "$f" .md)"
  # ponytail: mtime is best-effort across GNU/BSD; today is a fine fallback.
  ts="$(date -r "$f" +%F 2>/dev/null || date +%F)"
  tmp="$(mktemp)"
  # awk exits 0 when it rewrote the file, 1 when it was already conformant. Run it
  # inside `if` so `set -e` does not treat "no change needed" as a fatal error.
  # BINMODE=3 stops gawk-on-Windows opening in text mode and eating CRs; it is an
  # unused variable everywhere else.
  if awk -v BINMODE=3 -v type="$type" -v title="$title" -v ts="$ts" '
    { lines[NR] = $0 }
    NR == 1 {
      cr = (/\r$/) ? "\r" : ""
      hasfm = (/^---[[:space:]]*$/) ? 1 : 0
    }
    hasfm && NR > 1 && !closed && /^---[[:space:]]*$/  { closed = 1 }
    hasfm && NR > 1 && !closed && /^type:[[:space:]]*[^[:space:]]/ { typed = 1 }
    END {
      if (hasfm && typed) { for (i = 1; i <= NR; i++) print lines[i]; exit 1 }
      if (hasfm) {
        print lines[1]
        print "type: " type cr
        for (i = 2; i <= NR; i++) print lines[i]
        exit 0
      }
      # No frontmatter at all — hand-made file. Prepend a minimal conformant block.
      print "---" cr; print "type: " type cr; print "title: " title cr
      print "timestamp: " ts cr; print "---" cr; print "" cr
      for (i = 1; i <= NR; i++) print lines[i]
      exit 0
    }
  ' "$f" > "$tmp"; then
    cat "$tmp" > "$f"   # preserve inode/permissions
    rm -f "$tmp"
    return 0
  fi
  rm -f "$tmp"
  return 1
}

# Walk the store, type anything untyped. Idempotent. Never touches date:/updated:.
okf_backfill() {
  local total=0 fixed=0 f rel
  for kind in notes docs; do
    [[ -d "$LOREKEEPER_HOME/$kind" ]] || continue
    while IFS= read -r -d '' f; do
      rel="${f#"$LOREKEEPER_HOME"/}"
      case "$(basename "$f")" in index.md|log.md) continue ;; esac  # OKF reserved
      total=$((total + 1))
      if okf_fix_file "$f" "$(okf_type_for "$rel")"; then fixed=$((fixed + 1)); fi
    done < <(find "$LOREKEEPER_HOME/$kind" -type f -name '*.md' -print0 2>/dev/null)
  done
  printf "okf: %d concepts typed (%d backfilled)\n" "$total" "$fixed"
}

open_file() {
  local kind="$1" repo="$2" slug="$3"
  [[ -n "$repo" ]] || die "repo name required"
  [[ -n "$slug" ]] || die "slug required"
  local dir="$LOREKEEPER_HOME/$kind/$repo"
  mkdir -p "$dir"
  local file="$dir/$slug.md"
  # OKF v0.1 requires a non-empty `type` on every concept; derive it from the tree.
  local type="note"; [[ "$kind" == "docs" ]] && type="doc"
  if [[ ! -f "$file" ]]; then
    ensure_template
    sed \
      -e "s|__TYPE__|$type|g" \
      -e "s|__REPO__|$repo|g" \
      -e "s|__SLUG__|$slug|g" \
      -e "s|__DATE__|$(date +%F)|g" \
      -e "s|__TITLE__|$slug|g" \
      "$TEMPLATE_NOTE" > "$file"
  fi
  open_editor "$file"
  # Best-effort reindex (foreground, short)
  ( qmd update && qmd embed ) >/dev/null 2>&1 || true
}

case "$cmd" in
  home) echo "$LOREKEEPER_HOME" ;;

  help|-h|--help) printf '%s' "$USAGE" ;;

  status)
    printf "home:        %s\n" "$LOREKEEPER_HOME"
    printf "qmd:         "
    if command -v qmd >/dev/null; then printf "installed (%s)\n" "$(qmd --version 2>/dev/null || echo 'unknown')"
    else printf "NOT FOUND\n"; fi
    printf "collections: "
    qmd collection list 2>/dev/null | grep -E "lorekeeper-(notes|docs)" || echo "(none registered)"
    printf "\nhooks (canonical at \$LOREKEEPER_HOME/hooks):\n"
    for h in prime.sh reindex.sh autonote.sh; do
      if [[ -x "$LOREKEEPER_HOME/hooks/$h" ]]; then printf "  %s ✓\n" "$h"
      else printf "  %s MISSING\n" "$h"; fi
    done
    printf "\nclaude:\n"
    if [[ -d "$CLAUDE_DIR" ]]; then
      for h in lorekeeper-prime.sh lorekeeper-reindex.sh lorekeeper-autonote.sh; do
        if [[ -x "$CLAUDE_DIR/hooks/$h" ]]; then printf "  %s ✓\n" "$h"
        else printf "  %s MISSING\n" "$h"; fi
      done
      if grep -qF "<!-- LOREKEEPER:START -->" "$CLAUDE_DIR/CLAUDE.md" 2>/dev/null; then
        printf "  CLAUDE.md policy block: present\n"
      else
        printf "  CLAUDE.md policy block: MISSING\n"
      fi
    else
      printf "  (not installed — %s missing)\n" "$CLAUDE_DIR"
    fi
    printf "\nomp:\n"
    if [[ -d "$OMP_DIR" ]]; then
      omp_plugin_link="$OMP_DIR/plugins/node_modules/@lorekeeper/omp-plugin"
      if [[ -L "$omp_plugin_link" || -e "$omp_plugin_link" ]]; then
        printf "  plugin: linked (%s)\n" "$omp_plugin_link"
      else
        printf "  plugin: NOT LINKED\n"
      fi
      if grep -qF "<!-- LOREKEEPER:START -->" "$OMP_DIR/AGENTS.md" 2>/dev/null; then
        printf "  AGENTS.md policy block: present\n"
      else
        printf "  AGENTS.md policy block: MISSING\n"
      fi
    else
      printf "  (not installed — %s missing)\n" "$OMP_DIR"
    fi
    printf "\nautonote: "
    if [[ -e "$LOREKEEPER_HOME/.autonote-off" ]] || [[ "${LOREKEEPER_AUTONOTE:-on}" == "off" ]]; then
      echo "disabled"
    else
      echo "enabled"
    fi
    printf "caveman:  "
    if command -v claude >/dev/null && claude plugin list 2>/dev/null | grep -qi caveman; then
      echo "active"
    else
      echo "not installed"
    fi
    ;;

  add-repo)
    name="${1:-}"; [[ -n "$name" ]] || die "usage: lorekeeper add-repo <name>"
    mkdir -p "$LOREKEEPER_HOME/notes/$name" "$LOREKEEPER_HOME/docs/$name"
    qmd context add "qmd://lorekeeper-notes/$name" "Memory for repo '$name'" 2>/dev/null || true
    qmd context add "qmd://lorekeeper-docs/$name"  "Reference docs for repo '$name'" 2>/dev/null || true
    echo "registered '$name'"
    ;;

  note) open_file notes "${1:-}" "${2:-}" ;;
  doc)  open_file docs  "${1:-}" "${2:-}" ;;

  ls)
    repo="${1:-}"
    if [[ "$repo" == "--orphans" ]]; then
      # Keys whose name looks like "<existingkey>-<suffix>" — likely orphaned
      # worktree memory from before worktrees shared a key. A hint only.
      nd="$LOREKEEPER_HOME/notes"
      keys=()
      if [[ -d "$nd" ]]; then
        while IFS= read -r d; do keys+=("$(basename "$d")"); done \
          < <(find "$nd" -mindepth 1 -maxdepth 1 -type d 2>/dev/null)
      fi
      found=0
      if [[ "${#keys[@]}" -gt 0 ]]; then   # bash 3.2 + set -u aborts on empty "${keys[@]}"
        for a in "${keys[@]}"; do
          for b in "${keys[@]}"; do
            [[ "$a" == "$b" ]] && continue
            if [[ "$a" == "$b-"* ]]; then
              printf "  %-28s maybe worktree of '%s'  ->  lorekeeper merge-key %s %s\n" "$a" "$b" "$a" "$b"
              found=1
            fi
          done
        done
      fi
      [[ "$found" == 0 ]] && echo "(no orphan-looking keys)"
    elif [[ -n "$repo" ]]; then
      for kind in notes docs; do
        d="$LOREKEEPER_HOME/$kind/$repo"
        [[ -d "$d" ]] || continue
        printf "\n== %s/%s ==\n" "$kind" "$repo"
        find "$d" -type f -name '*.md' 2>/dev/null | sed "s|^$d/|  |" | sort
      done
    else
      for kind in notes docs; do
        printf "\n== %s ==\n" "$kind"
        if [[ -d "$LOREKEEPER_HOME/$kind" ]]; then
          for r in "$LOREKEEPER_HOME/$kind"/*/; do
            [[ -d "$r" ]] || continue
            repo="$(basename "$r")"
            count="$(find "$r" -type f -name '*.md' 2>/dev/null | wc -l | tr -d ' ')"
            printf "  %-30s %s file(s)\n" "$repo" "$count"
          done
        fi
      done
    fi
    ;;

  reindex)
    okf_backfill
    qmd update && qmd embed
    ;;

  skipped)
    repo_filter="${1:-}"
    skipped_log="$LOREKEEPER_HOME/.skipped.log"
    if [[ ! -f "$skipped_log" ]]; then
      echo "(no skipped sessions logged yet)"
    elif [[ -n "$repo_filter" ]]; then
      grep $'\t'"$repo_filter"$'\t' "$skipped_log" 2>/dev/null \
        || echo "(no skipped sessions for '$repo_filter')"
    else
      cat "$skipped_log"
    fi
    ;;

  validate)
    repo="${1:-}"; [[ -n "$repo" ]] || die "usage: lorekeeper validate <repo>"
    notes_dir="$LOREKEEPER_HOME/notes/$repo"
    [[ -d "$notes_dir" ]] || die "no notes for repo '$repo'"
    stale_cutoff="$(date -d "90 days ago" +%Y-%m-%d 2>/dev/null \
      || date -v-90d +%Y-%m-%d 2>/dev/null \
      || die "cannot compute date; check your OS date command")"
    stale_files=()
    while IFS= read -r -d '' f; do
      note_date="$(grep -m1 '^updated:' "$f" 2>/dev/null | sed 's/^updated:[[:space:]]*//')"
      [[ -z "$note_date" ]] && note_date="$(grep -m1 '^date:' "$f" 2>/dev/null | sed 's/^date:[[:space:]]*//')"
      if [[ -n "$note_date" && "$note_date" < "$stale_cutoff" ]]; then
        stale_files+=("$f")
        printf "STALE (%s): %s\n" "$note_date" "$(basename "$f")"
      fi
    done < <(find "$notes_dir" -maxdepth 1 -type f -name '*.md' -print0 2>/dev/null)
    if [[ "${#stale_files[@]}" -eq 0 ]]; then
      echo "No stale notes for '$repo' (90-day threshold)."
    else
      printf "\n%d stale note(s). Edit each and bump 'updated:' to mark validated.\n" "${#stale_files[@]}"
      printf "Open all for review? [y/N] "
      read -r answer
      if [[ "$answer" =~ ^[Yy] ]]; then
        for f in "${stale_files[@]}"; do
          open_editor "$f"
        done
      fi
    fi
    ;;

  distill)
    command -v claude >/dev/null || die "claude CLI not on PATH"
    here="$(pwd)"
    command -v lk_resolve >/dev/null 2>&1 || die "resolver lib missing ($HOOKS_DIR/lib/resolve.sh)"
    lk_resolve "$here"
    [[ -n "$LK_TOPLEVEL" ]] || die "run this from inside a git worktree"
    repo_arg="${1:-$LK_KEY}"
    if [[ "$LK_KEY" != "$repo_arg" ]]; then
      die "current repo key is '$LK_KEY', not '$repo_arg' — cd into that repo first"
    fi
    repo="$repo_arg"
    notes_dir="$LOREKEEPER_HOME/notes/$repo"
    docs_dir="$LOREKEEPER_HOME/docs/$repo"
    mkdir -p "$docs_dir"

    cat <<INFO
==> distilling durable docs for '$repo'
    notes:  $notes_dir
    docs:   $docs_dir
    (this spawns Sonnet with Read/Glob/Grep/Write; may take minutes)
INFO

    prompt="You are generating durable engineering documentation for the repo at the current working directory (name: $repo).

INPUTS:
- Scratch notes are in: $notes_dir (use Read/Glob to enumerate and load)
- Repo source is at the current working directory (use Glob/Grep/Read)

OUTPUTS (write each with the Write tool, only if you have substantive content):
- $docs_dir/architecture.md   — system design, major components, data flow, key entry points
- $docs_dir/onboarding.md     — getting started, env setup, first contribution walkthrough
- $docs_dir/runbook.md        — ops procedures, deploy, rollback, debugging production
- $docs_dir/conventions.md    — coding style, naming, patterns, testing conventions
- $docs_dir/api.md            — public API reference (endpoints, types, commands); skip if the repo has no public surface

SAFETY:
- DO NOT modify any files outside $docs_dir. Never Edit or Write into the repo source tree.
- If a target doc contains a block delimited by <!-- AUTODOC:START --> and <!-- AUTODOC:END -->, only rewrite content INSIDE those sentinels. Preserve everything outside verbatim.
- If a target doc exists and has NO sentinels, treat it as hand-curated: read it, merge respectfully (add sections, refine existing prose), do not wholesale replace it.

METHOD:
1. First, list and skim all notes under $notes_dir.
2. Then scan the repo structure: top-level files, package/module layout, entry points, README, tests, CI config.
3. For each target doc, write content only if you have substantive grounded material. If you lack evidence for a section, omit it. Do NOT hallucinate features, endpoints, or configs.
4. Prefer concrete references: cite files as \`path:line\` or \`path\`. Show real commands, not placeholders.
5. Keep prose terse: drop articles, fragments ok, technical identifiers exact.

OUTPUT DISCIPLINE:
- Each file starts with YAML frontmatter: \`repo: $repo\`, \`type: <architecture|onboarding|runbook|conventions|api>\`, \`updated: $(date +%Y-%m-%d)\`.
- Use a single H1 matching the doc type, then H2 sections.
- When you finish, print a one-line summary of which files you wrote or updated."

    LOREKEEPER_AUTONOTE_CHILD=1 claude -p "$prompt" \
      --model claude-sonnet-4-6 \
      --add-dir "$docs_dir" --add-dir "$notes_dir" \
      --allowed-tools "Read,Glob,Grep,Write" \
      --permission-mode bypassPermissions

    ( qmd update && qmd embed ) >/dev/null 2>&1 || true

    # Clear distill-pending flag and update watermark.
    pending_flag="$LOREKEEPER_HOME/.distill-pending/$repo"
    [[ -f "$pending_flag" ]] && rm -f "$pending_flag"
    notes_count="$(find "$LOREKEEPER_HOME/notes/$repo" -maxdepth 1 -type f -name '*.md' \
      2>/dev/null | wc -l | tr -d ' ')"
    watermark_dir="$LOREKEEPER_HOME/.distill-watermark"
    mkdir -p "$watermark_dir"
    echo "$notes_count" > "$watermark_dir/$repo"
    ;;

  tokens)
    if [[ "${1:-}" == "--transcripts" ]]; then
      # Phase 2 gate: scan recent transcripts for mcp qmd *query* results and report
      # median result size + cross-key contamination. Build the MCP only if either
      # trips (>20% cross-key, or median > 1500 tok).
      days="${2:-7}"
      command -v jq >/dev/null || die "jq required for --transcripts"
      set +e +o pipefail   # analysis only; tolerate per-file jq/SIGPIPE hiccups
      proj="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects"
      scan_dirs=("$proj")
      [[ -d "$LOREKEEPER_HOME/transcripts" ]] && scan_dirs+=("$LOREKEEPER_HOME/transcripts")
      tmp="$(mktemp)"
      nfiles=0
      for d in "${scan_dirs[@]}"; do
        [[ -d "$d" ]] || continue
        while IFS= read -r f; do
          nfiles=$((nfiles + 1))
          scwd="$(jq -r 'select(.cwd) | .cwd' "$f" 2>/dev/null | head -1)"
          skey=""
          if [[ -n "$scwd" ]]; then
            swin="$scwd"
            command -v cygpath >/dev/null 2>&1 && swin="$(cygpath -u "$scwd" 2>/dev/null || echo "$scwd")"
            if [[ -d "$swin" ]] && command -v lk_key >/dev/null 2>&1; then skey="$(lk_key "$swin")"; else skey="$(basename "$scwd")"; fi
          fi
          # Pair qmd *query* tool_use ids (assistant) with tool_result (user). Skip
          # api-request* lines, which re-send history and would double-count.
          jq -s -r --arg sk "$skey" '
            [ .[] | select(.type=="assistant") | (.message.content? // []) | .[]?
              | select(.type=="tool_use" and (.name|ascii_downcase|test("qmd.*query"))) | .id ] as $ids
            | ($ids | map({(.):true}) | add // {}) as $set
            | [ .[] | select(.type=="user") | (.message.content? // []) | .[]?
                | select(.type=="tool_result" and ($set[.tool_use_id] // false)) ]
            | .[]
            | (if (.content|type)=="string" then .content else ([.content[]?|.text? // ""]|join("")) end) as $t
            | ([ $t | scan("lorekeeper-(?:notes|docs)/([^/\"]+)/") ] | unique) as $k
            | [ ($t|length), (if ($k - [$sk] | length) > 0 then 1 else 0 end) ] | @tsv
          ' "$f" 2>/dev/null >> "$tmp"
        done < <(find "$d" -name '*.jsonl' -mtime -"$days" 2>/dev/null)
      done
      awk -F'\t' -v days="$days" -v nf="$nfiles" '
        { n++; cross += $2; toks[n] = int($1/4) }
        END {
          printf "transcript gate (last %s days, %d files scanned)\n", days, nf
          if (n == 0) { print "  qmd query results: 0 — insufficient data; stop at Phase 1."; exit 0 }
          # median
          for (i=1;i<=n;i++) for (j=i+1;j<=n;j++) if (toks[j]<toks[i]) { t=toks[i];toks[i]=toks[j];toks[j]=t }
          med = (n%2) ? toks[(n+1)/2] : int((toks[n/2]+toks[n/2+1])/2)
          cp = (cross*100.0)/n
          printf "  qmd query results:   %d\n", n
          printf "  median result size:  %d tok  (gate: >1500)\n", med
          printf "  cross-key results:   %.1f%%  (gate: >20%%)\n", cp
          trip = (cp > 20 || med > 1500)
          printf "  verdict: %s\n", (trip ? "GATE TRIPPED — Phase 2 (thin MCP) warranted" : "gate not tripped — stop at Phase 1")
        }
      ' "$tmp"
      rm -f "$tmp"
      exit 0
    fi
    # Estimate per-session token cost (chars/4): policy block + prime + precompact.
    path="${1:-.}"
    [[ -d "$path" ]] || die "not a directory: $path"
    abs="$(cd "$path" && pwd)"
    est() { awk '{ n += length($0) + 1 } END { printf "%d", int(n/4) }'; }

    # Policy block: installed CLAUDE.md block if present, else the repo template.
    policy=""
    if grep -qF "<!-- LOREKEEPER:START -->" "$CLAUDE_DIR/CLAUDE.md" 2>/dev/null; then
      policy="$(awk '/<!-- LOREKEEPER:START -->/{f=1} f{print} /<!-- LOREKEEPER:END -->/{f=0}' "$CLAUDE_DIR/CLAUDE.md")"
      psrc="installed CLAUDE.md block"
    elif [[ -f "$_LK_SELFDIR/../templates/CLAUDE.md" ]]; then
      policy="$(cat "$_LK_SELFDIR/../templates/CLAUDE.md")"
      psrc="repo template CLAUDE.md"
    else
      psrc="(none)"
    fi

    envelope="$(printf '{"cwd":"%s","hook_event_name":"SessionStart"}' "$abs")"
    prime_out="$(printf '%s' "$envelope" | LOREKEEPER_HOME="$LOREKEEPER_HOME" bash "$HOOKS_DIR/prime.sh" 2>/dev/null || true)"
    precompact_out="$(printf '%s' "$envelope" | LOREKEEPER_HOME="$LOREKEEPER_HOME" bash "$HOOKS_DIR/precompact.sh" 2>/dev/null || true)"

    pt="$(printf '%s' "$policy" | est)"
    rt="$(printf '%s' "$prime_out" | est)"
    ct="$(printf '%s' "$precompact_out" | est)"
    key="?"; command -v lk_resolve >/dev/null 2>&1 && { lk_resolve "$abs"; key="$LK_KEY"; }

    printf "tokens for key '%s'  (path: %s)\n" "$key" "$abs"
    printf "  %-28s %6s tok\n" "policy ($psrc)" "$pt"
    printf "  %-28s %6s tok\n" "prime output" "$rt"
    printf "  %-28s %6s tok\n" "precompact output" "$ct"
    printf "  %-28s %6s tok\n" "TOTAL" "$((pt + rt + ct))"
    ;;

  merge-key)
    from="${1:-}"; to="${2:-}"
    [[ -n "$from" && -n "$to" ]] || die "usage: lorekeeper merge-key <from> <to>"
    [[ "$from" == "$to" ]] && die "from and to are the same key"
    # Keys are single path segments. Reject anything that could escape the store.
    for k in "$from" "$to"; do
      case "$k" in
        .|..|*/*|*\\*) die "invalid key '$k' (must be a single name, no / \\ . ..)" ;;
      esac
    done
    moved=0
    for kind in notes docs; do
      src="$LOREKEEPER_HOME/$kind/$from"
      [[ -d "$src" ]] || continue
      dst="$LOREKEEPER_HOME/$kind/$to"
      mkdir -p "$dst"
      # Next ADR number in the destination, so merged ADRs continue its sequence.
      next_adr=1
      if [[ -d "$dst/adr" ]]; then
        max=0
        while IFS= read -r a; do
          n="$(basename "$a" | sed -n 's/^ADR-\([0-9]\{1,\}\)-.*/\1/p')"
          [[ -n "$n" && "$((10#$n))" -gt "$max" ]] && max="$((10#$n))"
        done < <(find "$dst/adr" -maxdepth 1 -type f -name 'ADR-*.md' 2>/dev/null)
        next_adr="$((max + 1))"
      fi
      while IFS= read -r -d '' f; do
        rel="${f#"$src"/}"
        case "$rel" in
          adr/ADR-*)
            slug="$(basename "$rel" | sed 's/^ADR-[0-9]\{1,\}-//')"
            mkdir -p "$dst/adr"
            target="$dst/adr/$(printf 'ADR-%04d-%s' "$next_adr" "$slug")"
            next_adr="$((next_adr + 1))"
            ;;
          *)
            target="$dst/$rel"
            mkdir -p "$(dirname "$target")"
            if [[ -e "$target" ]]; then
              # Keep both on collision; never overwrite an existing -from- copy.
              base="${target%.md}-from-$from"; target="$base.md"; i=2
              while [[ -e "$target" ]]; do target="$base-$i.md"; i=$((i + 1)); done
            fi
            ;;
        esac
        mv "$f" "$target"
        moved="$((moved + 1))"
      done < <(find "$src" -type f -name '*.md' -print0 2>/dev/null | sort -z)
      # Drop now-empty source tree.
      find "$src" -type d -empty -delete 2>/dev/null || true
    done
    echo "merged $moved file(s): '$from' -> '$to'"
    # Register destination context + reindex (best-effort).
    qmd context add "qmd://lorekeeper-notes/$to" "Memory for repo '$to'" 2>/dev/null || true
    qmd context add "qmd://lorekeeper-docs/$to"  "Reference docs for repo '$to'" 2>/dev/null || true
    ( qmd update && qmd embed ) >/dev/null 2>&1 || true
    ;;

  *) die "unknown command: $cmd  (try: lorekeeper help)" ;;
esac
